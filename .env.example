# ════════════════════════════════════════════════════
#  Pharma Core — Environment Variables
#  Copy this file to .env.local and fill in values.
#  NEVER commit .env.local to version control.
# ════════════════════════════════════════════════════

# ── Firebase Client SDK ──────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ── Firebase Admin SDK (Server-side only) ────────────
# Base64-encode your serviceAccount.json:
#   cat serviceAccount.json | base64
FIREBASE_ADMIN_SDK_KEY=base64_encoded_service_account_json

# ── Paymob Payment Gateway ──────────────────────────
PAYMOB_API_KEY=your_paymob_api_key
PAYMOB_CARD_INTEGRATION_ID=your_card_integration_id
PAYMOB_VODAFONE_INTEGRATION_ID=your_vodafone_integration_id
PAYMOB_INSTAPAY_INTEGRATION_ID=your_instapay_integration_id
PAYMOB_IFRAME_ID=your_iframe_id
PAYMOB_HMAC_SECRET=your_hmac_secret

# ── AI Tutor (Anthropic Claude) ──────────────────────
ANTHROPIC_API_KEY=sk-ant-your_key_here

# ── Video Providers (optional) ───────────────────────
BUNNY_API_KEY=your_bunny_api_key
BUNNY_PULLZONE=your_pullzone_name
VIMEO_ACCESS_TOKEN=your_vimeo_token

# ── VAPID Keys for Push Notifications ───────────────
# Generate: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key

# ── App ──────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_SECRET=generate_with_openssl_rand_base64_32
